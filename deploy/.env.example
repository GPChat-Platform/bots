# Clés API des bots (console développeur GPChat → Identifiants de chaque application)
CINEMA_GPCHAT_API_KEY=
DEVFEST_GPCHAT_API_KEY=
ALERTS_GPCHAT_API_KEY=
REMINDERS_GPCHAT_API_KEY=

# TMDB : « Read Access Token » (https://www.themoviedb.org/settings/api) ; OMDb : clé facultative
TMDB_TOKEN=
OMDB_API_KEY=

# DevFest : userId des organisateurs autorisés à utiliser /annonce (séparés par des virgules)
DEVFEST_ADMIN_IDS=

# Dev Alerts : adresse publique HTTPS (reverse proxy vers 127.0.0.1:18090)
ALERTS_PUBLIC_URL=https://alertes.example.com

# Rappels : fuseau horaire par défaut des nouveaux utilisateurs
REMINDERS_DEFAULT_TZ=Africa/Douala
